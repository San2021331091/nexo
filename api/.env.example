DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Private API credential; set the same value in apps/admin/.env.local.
CORS_ORIGINS="*"
ADMIN_API_TOKEN=""

# Keys the mobile app sends as X-API-Key (32+ characters, comma separated). Required in
# production; leave empty locally to keep the API open while developing.
APP_API_KEYS=""

# Optional restriction on stream hosts (comma separated hostnames). Leave empty
# to play any HTTPS URL stored in the catalog; YouTube is always allowed.
PLAYBACK_ALLOWED_HOSTS=""

# TMDB supplies movie, series and drama listings, artwork and episode guides.
# A v3 API key or a v4 read access token both work. Without it those rails are empty.
TMDB_API_KEY=""

# Superembed plays movies and episodes by TMDB id; titles are listed only after it
# confirms it has them. Leave empty for https://multiembed.mov, set a different
# HTTPS base if it moves domain, or set "off" to disable it.
SUPEREMBED_BASE_URL=""

# YouTube channel ids (UC...) whose uploads fill the Sports rails, comma separated.
# Leave empty for the built-in defaults, or set "off" to disable.
SPORTS_YOUTUBE_CHANNELS=""

# Server 2+ for movies: openly licensed (public domain / Creative Commons)
# Internet Archive films matched by TMDB title and year. "off" to disable.
INTERNET_ARCHIVE_PROVIDER=""

# Full episodes and full movies from official YouTube channels, synced daily into
# the youtube_library table (Vercel: the /api/cron/youtube-library cron). Comma
# separated channel ids per tab, empty for the built-in defaults, or "off".
MOVIES_FULL_YOUTUBE_CHANNELS=""
SERIES_FULL_YOUTUBE_CHANNELS=""
DRAMAS_FULL_YOUTUBE_CHANNELS=""
# "off" stops the in-process daily sync (long-running servers only).
YOUTUBE_LIBRARY_SYNC=""

# NEXO Assistant (in-app chat). An OpenRouter key enables it; the model can be
# any OpenRouter model id with tool support (default deepseek/deepseek-v4-flash).
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""
# Web search for the assistant (news, results, release dates outside NEXO data),
# through Tavily (https://tavily.com, free tier available). Set the key to enable;
# ASSISTANT_WEB_SEARCH="off" turns it off without removing the key.
TAVILY_API_KEY=""
ASSISTANT_WEB_SEARCH=""
