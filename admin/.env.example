# Copy to .env.local. Keep this file private; do not prefix secrets with NEXT_PUBLIC_.
# Server only. Set to use a separately running API (e.g. the Nest dev server);
# leave unset on Vercel so the API runs inside the admin app at /api/v1.
API_BASE_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_CONTENT_REPORT_EMAIL=""

# Operator login checked by the admin server.
ADMIN_LOGIN_USERNAME="admin"
ADMIN_LOGIN_PASSWORD="admin123"

# Must match ADMIN_API_TOKEN in apps/api/.env. This stays on the admin server.
ADMIN_API_TOKEN=""

# Vercel Cron credential for /api/cron/channel-health (16+ random characters).
CRON_SECRET=""
